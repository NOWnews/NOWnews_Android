<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/reference_news_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:drawableLeft="@drawable/relation_news_icon"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="@string/reference_news"
        android:textColor="@android:color/black"
        android:textSize="20dp" />

    <TextView
        android:id="@+id/headline_news_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:drawableLeft="@drawable/instant_news_icon"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="@string/headline_news"
        android:textColor="@android:color/black"
        android:textSize="20dp"
        android:visibility="gone"/>

</RelativeLayout>