<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.nownews.mobile.Widget.CustomImageTopcrop
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/banner_cover"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp">

        <TextView
            android:id="@+id/news_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="TitleTitleTitle"
            android:textColor="@android:color/white"
            android:textSize="20dp" />

        <LinearLayout
            android:id="@+id/dot_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/news_title"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot1"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/top_news_dot" />

            <ImageView
                android:id="@+id/dot2"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/top_news_dot_ring" />

            <ImageView
                android:id="@+id/dot3"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/top_news_dot_ring" />

            <ImageView
                android:id="@+id/dot4"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginLeft="10dp"
                android:src="@drawable/top_news_dot_ring" />

        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>